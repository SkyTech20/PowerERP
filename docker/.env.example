# PowerERP (docker/docker-compose.yml). Copy to .env and fill in. Never commit .env.
# Comments stay on their own lines: Docker reads everything after "=" as the value.

# One project per client: its own database volume and port (README.md, "Several clients").
COMPOSE_PROJECT_NAME=powererp

# --- Required
ERP_DB_PASSWORD=change-me-db
# The administrator created on the first start (6 characters or more)
ERP_ADMIN_PASSWORD=change-me-admin

# --- Web access
ERP_PORT=5050
# 127.0.0.1 behind nginx (HTTPS); 0.0.0.0 to open the port on the network
ERP_BIND=127.0.0.1
# 1 when the ERP is reached over HTTPS
ERP_COOKIE_SECURE=0

# --- Optional
ERP_ADMIN_USER=admin
# Empty: a random key kept in the database
ERP_SECRET_KEY=
# For SkyAI and scripts (header X-API-Key). Empty: no key
ERP_API_KEY=
# demo: seed the fictitious data of data/demo
ERP_DATASET=default
# Dockerfile.demo: an image with the fictitious data only
ERP_DOCKERFILE=Dockerfile
# Image name, e.g. skytnttech/skyai-demo-erp-sample:latest to push it
ERP_IMAGE=powererp:latest
# Folder of the server where Administration > Backups writes
ERP_BACKUP_DIR=./backups
# 0 turns off the automatic backups of the ERP
BACKUP_SCHEDULER=1
