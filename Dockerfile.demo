# Public demo image: ships ONLY the fictitious data in data/demo (no real supplier/PO data from data/*.json).
FROM python:3.10-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py erp_api.py powerware_api.py purchasing_api.py inventory_api.py db.py auth.py alembic.ini ./
COPY powererp/ ./powererp/
COPY migrations/ ./migrations/
COPY static/ ./static/
COPY data/demo/ ./data/demo/
# Products, taxes and inventory seed (fictitious, shared by both datasets)
COPY data/inventory.json ./data/

# Database: PostgreSQL, set DATABASE_URL (postgresql://user:password@host:5432/powererp).
# The schema is created and migrated by the ERP when it starts (Alembic).
ENV PORT=5050 \
    ERP_DATASET=demo
EXPOSE 5050

CMD ["python", "app.py"]
